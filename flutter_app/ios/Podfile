# Plateforme iOS minimale — alignée avec le déploiement Kolyb
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# flutter_local_notifications 18.x utilise des guillemets dans ses headers umbrella,
# incompatible avec use_frameworks! — on le force en bibliothèque statique.
pre_install do |installer|
  # Ces plugins utilisent le nouveau format Swift Package Manager
  # incompatible avec use_frameworks! — on les force en bibliothèque statique
  static_pods = %w[
    flutter_local_notifications
    share_plus
    sqflite_darwin
    in_app_review
  ]
  installer.pod_targets.each do |pod|
    if static_pods.include?(pod.name)
      def pod.build_type
        Pod::BuildType.static_library
      end
    end
  end
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Désactive la signature sur tous les targets de pods (y compris _privacy)
      config.build_settings['CODE_SIGNING_ALLOWED']             = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED']            = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY']               = ''
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY']      = ''
      config.build_settings['PROVISIONING_PROFILE_SPECIFIER']   = ''
      # Aligne le déploiement iOS minimum pour éviter les warnings
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']       = '16.0'
      # Empêche firebase_core 3.x de bloquer la build sur Xcode récent
      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS']              = 'NO'
      config.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS']            = 'NO'
      # Supprime les warnings deprecated (Firebase, FCM, flutter_local_notifications, RevenueCat)
      config.build_settings['GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS']       = 'NO'
      config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
      config.build_settings['CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF']      = 'NO'
      # Fix nanopb / GoogleDataTransport incompatible avec Xcode 26 (clang C99 strict)
      if target.name == 'GoogleDataTransport'
        config.build_settings['OTHER_CFLAGS'] = '$(inherited) -Wno-implicit-function-declaration -Wno-strict-prototypes'
      end
      # Fix nanopb pb.h "double-quoted include in framework header" (Xcode 26 / clang strict)
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      # Fix "Stale file outside allowed root paths" (bundles _Privacy dans DerivedData)
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING']             = 'NO'
    end
  end
end
